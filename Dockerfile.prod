# Stage 1: Build (requires devDependencies)
FROM oven/bun:1-alpine@sha256:5a1fe2d60106ee903ee62008deab884376f18e07bbb6676cc86e9e1e1e710690 AS build

WORKDIR /app

# Copy project files
COPY . .

# Install all dependencies (including devDependencies for build)
RUN bun install --frozen-lockfile \
    && bun run build

# Stage 2: Production dependencies only
FROM oven/bun:1-alpine@sha256:5a1fe2d60106ee903ee62008deab884376f18e07bbb6676cc86e9e1e1e710690 AS deps

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install production dependencies only
RUN bun install --frozen-lockfile --production --ignore-scripts

# Stage 3: Production runtime
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS prod

# Install curl for healthcheck
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copy package files for production install
COPY --from=build /app/package.json ./package.json

# Copy production node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy built files from build stage
COPY --from=build /app/dist ./dist

# Set ownership and switch to non-root user
RUN chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "./dist/server.js"]